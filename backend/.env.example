# ==========================================
# ORCA Backend Configuration
# ==========================================

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://orca_user:orca_password@localhost:5432/orca_marine_db

# LLM Configuration
# Supported providers: gemini, openai, groq, ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (Allow all for easy frontend connection)
CORS_ORIGINS=["*"]
